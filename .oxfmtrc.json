{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",

	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,

	"experimentalSortImports": {
		"groups": [
			["builtin", "bun"],
			["oomfs"],
			["external"],
			["server"],
			["client"],
			["parent"],
			["sibling", "index"]
		],
		"customGroups": [
			{
				"groupName": "bun",
				"elementNamePattern": ["bun", "bun:**"]
			},
			{
				"groupName": "oomfs",
				"elementNamePattern": ["@atcute/**", "@danaus/**", "@kelinci/**", "@oomfware/**"]
			},
			{
				"groupName": "server",
				"elementNamePattern": ["#app/**"]
			},
			{
				"groupName": "client",
				"elementNamePattern": ["#web/**"]
			}
		]
	},

	"experimentalTailwindcss": {
		"stylesheet": "./packages/danaus/src/web/styles/main.css",
		"functions": ["cn"]
	},

	"overrides": [
		{
			"files": ["tsconfig.json", "tsconfig.*.json"],
			"options": {
				"parser": "jsonc"
			}
		},
		{
			"files": ["*.md"],
			"options": {
				"printWidth": 100,
				"proseWrap": "always"
			}
		}
	]
}
