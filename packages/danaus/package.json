{
	"name": "@kelinci/danaus-pds",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#app/*": "./src/*",
		"#web/*": "./src/web/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsgo -b && bun run css:build && bun run js:build",
		"test": "bun test",
		"app:watch": "bun run --watch src/bin/pds.ts",
		"css:build": "tailwindcss -i src/web/styles/main.css -o public/style.css",
		"css:watch": "tailwindcss -i src/web/styles/main.css -o public/style.css -w",
		"js:build": "bun run src/bin/build-web-assets.ts",
		"js:watch": "bun run src/bin/build-web-assets.ts --watch",
		"db:generate:account": "drizzle-kit generate --dialect=sqlite --schema=src/accounts/db/schema.ts --out=drizzle/accounts",
		"db:generate:actor": "drizzle-kit generate --dialect=sqlite --schema=src/actors/db/schema.ts --out=drizzle/actors",
		"db:generate:identity": "drizzle-kit generate --dialect=sqlite --schema=src/identity/db/schema.ts --out=drizzle/identity",
		"db:generate:lexicon": "drizzle-kit generate --dialect=sqlite --schema=src/lexicon/db/schema.ts --out=drizzle/lexicon",
		"db:generate:sequencer": "drizzle-kit generate --dialect=sqlite --schema=src/sequencer/db/schema.ts --out=drizzle/sequencer"
	},
	"dependencies": {
		"@atcute/atproto": "^4.0.0",
		"@atcute/bluesky": "^4.0.0",
		"@atcute/car": "^6.0.0",
		"@atcute/cbor": "^2.3.3",
		"@atcute/cid": "^2.4.1",
		"@atcute/client": "^5.0.0",
		"@atcute/crypto": "^2.4.1",
		"@atcute/did-plc": "^1.0.0",
		"@atcute/identity": "^2.0.0",
		"@atcute/identity-resolver": "^2.0.0",
		"@atcute/identity-resolver-node": "^2.0.0",
		"@atcute/lexicon-doc": "^3.0.0",
		"@atcute/lexicon-resolver": "^1.0.0",
		"@atcute/lexicon-resolver-node": "^1.0.0",
		"@atcute/lexicons": "^2.0.0",
		"@atcute/mst": "^1.0.1",
		"@atcute/multibase": "^1.2.0",
		"@atcute/repo": "^1.0.0",
		"@atcute/tid": "^1.1.2",
		"@atcute/uint8array": "^1.1.1",
		"@atcute/util-fetch": "^2.0.0",
		"@atcute/xrpc-server": "^2.0.0",
		"@atcute/xrpc-server-bun": "^2.0.0",
		"@kelinci/danaus-lexicons": "workspace:*",
		"@logtape/logtape": "^2.0.5",
		"@oomfware/fetch-router": "^0.2.1",
		"@oomfware/forms": "^0.3.0",
		"@oomfware/jsx": "^0.2.0",
		"@simplewebauthn/server": "^13.3.0",
		"cva": "1.0.0-beta.4",
		"drizzle-orm": "1.0.0-beta.6-4414a19",
		"get-port": "^7.2.0",
		"jose": "^6.2.2",
		"nanoid": "^5.1.9",
		"p-queue": "^9.2.0",
		"qrcode": "^1.5.4",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@danaus/dev-env": "workspace:*",
		"@rollup/plugin-multi-entry": "^7.1.0",
		"@standard-schema/spec": "^1.1.0",
		"@tailwindcss/cli": "^4.2.4",
		"@types/bun": "^1.3.13",
		"@types/qrcode": "^1.5.6",
		"chokidar": "^5.0.0",
		"concurrently": "^9.2.1",
		"drizzle-kit": "1.0.0-beta.6-4414a19",
		"rolldown": "1.0.0-rc.17",
		"tailwindcss": "^4.2.4"
	}
}
