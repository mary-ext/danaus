{
	"name": "@kelinci/danaus-lexicons",
	"version": "0.0.0",
	"private": true,
	"description": "danaus schema definitions",
	"license": "0BSD",
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"exports": {
		".": "./lib/index.ts",
		"./types/*": "./lib/lexicons/types/local/danaus/*.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./types/*": "./dist/lexicons/types/local/danaus/*.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate",
		"export": "lex-cli export",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "^3.1.11",
		"@atcute/lexicons": "^1.3.0"
	},
	"devDependencies": {
		"@atcute/lex-cli": "^2.8.1",
		"@atcute/lexicon-doc": "^2.2.0",
		"@kelinci/danaus-lexicons": "file:"
	},
	"atcute:lexicons": {
		"mappings": {
			"local.danaus.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
